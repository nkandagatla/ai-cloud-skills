{
  "name": "ai-cloud-skills",
  "version": "1.3.1",
  "description": "Company skills library for AI coding agents: guardrailed AWS, Azure and GCP, git, languages (HTML, JS/TS, Node.js, Python, Java, Go, .NET, shell), databases and AI token-cost skills, with a pre-execution guard, an output token saver and a multi-agent installer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ai-cloud-skills": "bin/cli.mjs",
    "cloud-guard": "guard/cloud-guard.mjs",
    "token-saver": "guard/token-saver.mjs"
  },
  "files": [
    "bin",
    "guard",
    "skills",
    "templates",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "config": {
    "repo": "nkandagatla/ai-cloud-skills"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkandagatla/ai-cloud-skills"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "aws",
    "azure",
    "gcp",
    "terraform",
    "devops",
    "security",
    "guardrails",
    "git",
    "python",
    "java",
    "nodejs",
    "postgresql",
    "mongodb",
    "token-cost"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/build.mjs --check && node scripts/validate.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run validate && npm test"
  }
}
